%%BeginDocument: FIG/wcsGLS.ps

   /TextFont /Courier-Bold findfont 10 scalefont def

   % Constants.
   /cm2pts 72 2.54 div def
   /pi 3.1416 def
   /w1 0.4 def
   /w2 0.8 def
   /w4 1.6 def

   % Radius of the generating sphere.
   /r0 2 cm2pts mul def
   /r1 r0 pi mul 180 div def

   /DrawMeridian {
      setlinewidth
      DrawSinusoid
      stroke
      0 moveto
      -2 2 rmoveto
      90 rotate
      show
      -90 rotate
      stroke
      } def

   /DrawSinusoid {
      r1 mul neg
      /theta 90 def
      0 theta r1 mul moveto
      36 {
         /theta theta 5 sub def
         dup theta cos mul
         theta r1 mul lineto
         } repeat
      } def

   /DrawParallel {
      setlinewidth
      dup
      cos r1 mul 180 mul
      exch r1 mul
      2 copy dup 0 exch 6 2 roll
      exch neg exch moveto lineto moveto
      2 2 rmoveto
      show
      stroke
      } def



