%%BeginDocument: FIG/wcsMER.ps

   /TextFont /Courier-Bold findfont 15 scalefont def

   % Constants.
   /cm2pts 72 2.54 div def
   /pi 3.1416 def
   /w1 0.4 def
   /w2 0.8 def
   /w4 1.6 def

   % Radius of the generating sphere and map boundary.
   /r0 2 cm2pts mul def
   /xlim 3.1416 r0 mul def
   /ylim 2.5000 r0 mul def

   /DrawMeridian {
      setlinewidth
      pi mul 180 div
      r0 mul
      dup ylim neg moveto
      -3 6 rmoveto 3 -6 rlineto 3 6 rlineto -3 -6 rmoveto
      dup ylim lineto
      -3 -6 rmoveto 3 6 rlineto 3 -6 rlineto -3 6 rmoveto
      0 moveto
      -2 2 rmoveto
      90 rotate
      show
      -90 rotate
      stroke
      } def

   /DrawParallel {
      setlinewidth
      90 add 2 div dup sin exch cos div ln
      r0 mul
      dup xlim neg exch moveto
      dup xlim exch lineto
      0 exch moveto
      2 2 rmoveto
      show
      stroke
      } def


