%%BeginDocument: FIG/wcsAIR90.ps

   /TextFont /Courier-Bold findfont 22 scalefont def

   % Constants.
   /cm2pts 72 2.54 div def
   /w1 0.4 def
   /w2 0.8 def
   /w4 1.6 def

   % Radius of the generating sphere and map boundary.
   /r0 4 cm2pts mul def
   /nstr 13 string def

   /prt-n {
      dup abs 0.001 lt {pop 0} if
      nstr cvs show
      } def

   /Thetab 90 def
   /Pthetab 90 Thetab sub 2 div def
   /Thetal -36.4 def
   /Pthetal 90 Thetal sub 2 div def

   /lnTan {            % ln(cos(a))/tan(a) a on stack
      /MyArg exch def
      MyArg abs 1 lt {0}
         {MyArg cos dup ln mul MyArg sin div} ifelse
      } def

   /Rlim Pthetal lnTan Pthetab lnTan Pthetal sin mul Pthetal
           cos div add -4 mul r0 mul def

   /DrawMeridian {
      setlinewidth
      0 0 moveto
      dup neg rotate
      0 Rlim neg lineto
%      3 6 rmoveto -3 -6 rlineto -3 6 rlineto 3 -12 rmoveto
      0 -6 rmoveto
      exch dup stringwidth
      pop -2 div -13 rmoveto
      show
      rotate
      stroke
      } def

   /DrawParallel {
      setlinewidth
      /theta exch def
      /Ptheta 90  theta sub 2 div def
      Ptheta lnTan Pthetab lnTan Ptheta sin mul Ptheta
           cos div add -4 mul r0 mul dup
      0 0
      3 -1 roll
      0 360 arc
      0 exch neg moveto
      2 4 rmoveto
      show
      stroke
      } def


