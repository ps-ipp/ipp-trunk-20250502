%%BeginDocument: FIG/wcsSIN30.ps

   /TextFont /Courier-Bold findfont 22 scalefont def

   % Constants.
   /cm2pts 72 2.54 div def
   /w1 0.4 def
   /w2 0.8 def
   /w4 1.6 def

   % Radius of the generating sphere and map boundary.
   /r0 6 cm2pts mul def
   /eps r0 8 div def
   /Rlim 1.0000 r0 mul def

   /Zen 30 def
   /Par 45 def
 
   /alpha Zen sin Zen cos div Par sin mul def
   /beta Zen sin Zen cos div Par cos mul def

   /DrawMeridian {
      setlinewidth
      0 0 moveto
      /phi exch def
      /theta 90 def
      DoMove
      /Rm 0 def
      90 {
         /theta theta 1 sub def
         DoDrawR
         } repeat
      phi neg rotate
      dup stringwidth
      pop -2 div -23 rmoveto
      show
      phi rotate
      stroke
      } def

   /DrawParallel {
      setlinewidth
      /phi 0 def
      /theta exch def
      DoMove
      180 {
        /phi phi 2 add def
        DoDraw
        } repeat
      /phi 180 def
      DoMove
      4 4 rmoveto
      show
      stroke
      } def

   /DoMove {
      DoGeom
      newx newy moveto
      /oldx newx def
      /oldy newy def
      } def

   /DoDraw {
      DoGeom
      newx newy 
      newx oldx sub dup mul  newy oldy sub dup mul 
      add sqrt eps gt {moveto} {lineto} ifelse 
      /oldx newx def
      /oldy newy def
      } def

   /DoDrawR {
      DoGeom
      /Rcur newx newx mul newy newy mul add def
      Rcur Rm gt {
         newx newy 
         newx oldx sub dup mul  newy oldy sub dup mul 
         add sqrt eps gt {moveto} {lineto} ifelse
         /Rm Rcur def} 
         {/Rm 1000000 def } ifelse
      /oldx newx def
      /oldy newy def
      } def

   /DoGeom {
      /newx theta cos phi sin mul def
      /newy theta cos phi cos mul def
      /newx newx theta sin 1 sub alpha mul add def
      /newy newy theta sin 1 sub beta mul add def
      /newx newx r0 mul neg def
      /newy newy r0 mul neg def
      } def



