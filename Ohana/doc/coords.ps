   ()    0 w4 DrawMeridian
   ()   60 w2 DrawMeridian
   ()  120 w2 DrawMeridian
   ()  180 w4 DrawMeridian
   () -180 w4 DrawMeridian
   () -120 w2 DrawMeridian
   ()  -60 w2 DrawMeridian

   ()   60 w2 DrawParallel
