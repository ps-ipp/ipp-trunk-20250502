   /r0 2 cm2pts mul def
   /Rlim 4.0000 r0 mul def

   /DrawMeridian {
      setlinewidth
      0 0 moveto
      dup neg rotate
      0 Rlim neg lineto
      0 -4 rmoveto
      exch dup stringwidth
      pop -2 div -13 rmoveto
      show
      rotate
      stroke
      } def

   /DrawParallel {
      setlinewidth
      sin 1 exch sub 2 mul sqrt
      2 r0 mul mul dup
      0 0
      3 -1 roll
      0 360 arc
      0 exch neg moveto
      2 2 rmoveto
      show
      stroke
      } def


