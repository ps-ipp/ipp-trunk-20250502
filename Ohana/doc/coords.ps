%%BeginDocument: FIG/wcsSIN0.ps

   /TextFont /Courier-Bold findfont 22 scalefont def

   % Constants.
   /cm2pts 72 2.54 div def
   /w1 0.4 def
   /w2 0.8 def
   /w4 1.6 def

   % Radius of the generating sphere and map boundary.
   /r0 6 cm2pts mul def
   /eps r0 8 div def
   /Rlim 1.0000 r0 mul def

   /Zen 20 def
   /Par 45 def
 
   /alpha 0 def
   /beta 0 def

   /DrawMeridian {
      setlinewidth
      0 0 moveto
      /phi exch def
      /theta 90 def
      DoMove
      45 {
         /theta theta 2 sub def
         DoDraw
         } repeat
      phi neg rotate
      dup stringwidth
      pop -2 div -23 rmoveto
      show
      phi rotate
      stroke
      } def

   /DrawParallel {
      setlinewidth
      /phi 0 def
      /theta exch def
      DoMove
      180 {
        /phi phi 2 add def
        DoDraw
        } repeat
      4 4 rmoveto
      show
      stroke
      } def

   /DoMove {
      DoGeom
      newx newy moveto
      /oldx newx def
      /oldy newy def
      } def

   /DoDraw {
      DoGeom
      newx newy 
      newx oldx sub dup mul  newy oldy sub dup mul 
      add sqrt eps gt {moveto} {lineto} ifelse 
      /oldx newx def
      /oldy newy def
      } def

   /DoGeom {
      /newx theta cos phi sin mul def
      /newy theta cos phi cos mul def
      /newx newx theta sin 1 sub alpha mul add def
      /newy newy theta sin 1 sub beta mul add def
      /newx newx r0 mul neg def
      /newy newy r0 mul neg def
      } def



userdict /start-hook known {start-hook} if


/vmsave save def
TextFont setfont
2 setlinecap

