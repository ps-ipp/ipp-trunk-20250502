%%BeginDocument: FIG/wcsCODex.ps

   /TextFont /Courier-Bold findfont 15 scalefont def
   /LablFont /Courier-Bold findfont 27 scalefont def

% Constants.
   /cm2pts 72 2.54 div def
   /pi 3.1416 def
   /ws 0.4 def
   /nstr 14 string def

% Radius of the generating sphere.
   /r0 2 cm2pts mul def
   /r1 r0 pi mul 180 div def
   /eps r0 3.5 div def

% Basic functions
   /Asin {
      dup dup mul 1 sub neg sqrt Atan
      } def

   /Acos {
      dup dup mul 1 sub neg sqrt exch Atan
      } def

   /Atan {
      atan Fix
      } def

   /Fix {
      dup 180 gt {360 sub} if
      } def

   /abs {
      dup 0 lt {neg} if
      } def

  /prt-n {
      dup abs 0.001 lt {pop 0} if
      nstr cvs show
      } def

% translate to the North Pole
   /ToPole {
      /deltap delta0 sin phip cos div Acos def
      /alphap phip sin neg delta0 cos div
           deltap sin neg phip cos mul delta0 cos div
           Atan alpha0 add Fix def
      } def

   /DrawMeridian {
      ws mul setlinewidth
      /alpha exch def
      /delta 90 def
      DoMove
      120 {
         /delta delta 1.5 sub def
         DoDraw
         } repeat
      stroke
      MerShow
      } def

  /MerShow {
      /delta -0.5 def
      DoMove
      /delta 0.5 def
      DoGeom
      /TheRot newy oldy sub newx oldx sub Atan def
      /delta 0 def
      DoMove
      TheRot rotate
      2 2 rmoveto
      show
      TheRot neg rotate
      } def

  /DebugDelta {
      1.1 r0 mul delta 90 sub 1.3 mul moveto
      (Theta ) show theta prt-n
      ( Phi ) show phi prt-n
      ( X ) show newx prt-n
      ( Y ) show newy prt-n
      stroke
      newx newy moveto
      } def

   /DrawParallel {
      ws mul setlinewidth
      /delta exch def
      /alpha 180 def
      DoMove
      240 {
         /alpha alpha 1.5 sub def
         DoDraw
         } repeat
      stroke
      ParShow
      stroke
      } def

  /ParShow {
      /alpha -0.5 def
      DoMove
      /alpha 0.5 def
      DoGeom
      /TheRot newy oldy sub newx oldx sub Atan 180 add Fix def
      /alpha 0 def
      DoMove
      TheRot rotate
      2 2 rmoveto
      show
      TheRot neg rotate
      } def

   /DrawBoundary {                 % ok for GLS
      ws mul setlinewidth
      /phi 180 def
      /theta -90 def
      TheGeom
      newx newy moveto
      120 {
         /phi phi 3 sub def
         TheGeom
         newx newy lineto
         } repeat
      /phi -180 def
      /theta 90 def
      TheGeom
      newx newy lineto
      40 {
         /phi phi 9 add def
         TheGeom
         newx newy lineto
         } repeat
      /phi 180 def
      /theta -90 def
      TheGeom
      newx newy lineto
      } def

   /DoMove {
      DoGeom
      newx newy moveto
      /oldx newx def
      /oldy newy def
      } def

   /DoDraw {
      DoGeom
      newx newy 
      newx oldx sub dup mul  newy oldy sub dup mul 
      add sqrt eps gt {moveto} {lineto} ifelse 
      /oldx newx def
      /oldy newy def
      } def

   /DoGeom {
      GetTheta
      GetPhi
      TheGeom
      } def

   /TheGeom {                       % COD geometry
      /theta1 45 def
      /Rtemp theta1 theta sub r1 mul
                  theta1 cos theta1 sin div r0 mul add def
      /Atemp phi theta1 sin mul def
      /Ytemp Rtemp theta 90 sub r1 mul add def
      /newx Rtemp Atemp sin mul neg def
      /newy Ytemp Rtemp Atemp cos mul sub def
      } def

   /GetTheta {
      /theta delta sin deltap sin mul delta cos deltap cos mul
                alpha alphap sub cos mul add Asin def
      } def

   /GetPhi {
      theta cos 0.00001 gt
      {/phi alphap alpha sub sin delta cos mul
               delta sin deltap cos mul
               delta cos deltap sin mul alpha alphap sub cos mul sub
               Atan phip add Fix def}
      {/phi alpha alphap sub Fix 180 add Fix phip add Fix def}
      ifelse
      } def

   /DrawAll {
      4 DrawBoundary
      LablFont setfont
      0 1.35 r0 mul moveto show   % COD
      TextFont setfont

        (0)    0 3 DrawMeridian
%        ()    5 1 DrawMeridian
       (30)   30 2 DrawMeridian
%        ()   45 1 DrawMeridian
       (60)   60 2 DrawMeridian
%        ()   75 1 DrawMeridian
       (90)   90 3 DrawMeridian
%        ()  105 1 DrawMeridian
      (120)  120 2 DrawMeridian
%        ()  135 1 DrawMeridian
      (150)  150 2 DrawMeridian
%        ()  165 1 DrawMeridian
      (180)  180 3 DrawMeridian
      (180) -180 3 DrawMeridian
%        () -165 1 DrawMeridian
      (210) -150 2 DrawMeridian
%        () -135 1 DrawMeridian
      (240) -120 2 DrawMeridian
%        () -105 1 DrawMeridian
      (270)  -90 3 DrawMeridian
%        ()  -75 1 DrawMeridian
      (300)  -60 2 DrawMeridian
%        ()  -45 1 DrawMeridian
      (330)  -30 2 DrawMeridian
%        ()  -15 1 DrawMeridian

%        ()   75 1 DrawParallel
       (60)   60 2 DrawParallel
%        ()   45 1 DrawParallel
       (30)   30 2 DrawParallel
%        ()   15 1 DrawParallel
        (0)    0 3 DrawParallel
%        ()  -15 1 DrawParallel
      (-30)  -30 2 DrawParallel
%        ()  -45 1 DrawParallel
      (-60)  -60 2 DrawParallel
%        ()  -75 1 DrawParallel
   } def

   /DoAll {
      /alphap  0 def   /deltap 30 def   /phip 180 def  (A) DrawAll
      DeltaX 0 translate
      /alphap  0 def   /deltap 30 def   /phip 150 def  (B) DrawAll
      DeltaX neg DeltaY translate
      /alphap 45 def   /deltap 30 def   /phip 180 def  (C) DrawAll
      DeltaX 0 translate
      /alphap  0 def   /deltap 30 def   /phip  75 def  (D) DrawAll
      } def



userdict /start-hook known {start-hook} if


/vmsave save def
TextFont setfont
2 setlinecap

 202 190 translate

/DeltaX 430 def
/DeltaY 300 def

   DoAll

vmsave restore
showpage


userdict /end-hook known {end-hook} if
%%EndDocument

 endTexFig
