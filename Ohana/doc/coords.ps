%%BeginDocument: FIG/wcsTAN.ps

   /TextFont /Courier-Bold findfont 22 scalefont def

   % Constants.
   /cm2pts 72 2.54 div def
   /w1 0.4 def
   /w2 0.8 def
   /w4 1.6 def

   % Radius of the generating sphere and map boundary.
   /r0 2 cm2pts mul def
   /Rlim 3.9000 r0 mul def

   /DrawMeridian {
      setlinewidth
      0 0 moveto
      dup neg rotate
      0 Rlim neg lineto
      3 6 rmoveto -3 -6 rlineto -3 6 rlineto 3 -12 rmoveto
      exch dup stringwidth
      pop -2 div -13 rmoveto
      show
      rotate
      stroke
      } def

   /DrawParallel {
      setlinewidth
      dup cos exch sin div
      r0 mul dup
      0 0
      3 -1 roll
      0 360 arc
      0 exch neg moveto
      3 5 rmoveto
      show
      stroke
      } def


