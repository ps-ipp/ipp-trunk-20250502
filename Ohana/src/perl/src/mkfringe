	($col) = $_[0] =~ /$key.(\d+)/; 
    } else {
	$col = 0;
    }

    $line = $_[1];
    $message = $_[2];
    
    # list files: VERSION.imstats, VERSION.med.medbin.list, VERSION.med.tenbin.list, VERSION.def.medbin.list VERSION.def.tenbin.list

