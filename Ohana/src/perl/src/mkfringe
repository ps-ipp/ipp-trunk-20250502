sub flips_report {
    
    $col = 0;
    ($config) = $_[0] =~ /([-\w]+\.[-\w]+\.[-\w]+)/;
    ($key)    = $_[0] =~ /([-\w]+\.[-\w]+\.[-\w]+\.[-\w]+)/; # (config.ver)

