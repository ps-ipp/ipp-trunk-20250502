	    last;
	}
	# list of image map lists
	if ($type eq "modelist") {
	    $dir = mkfiles ("fringe");
	    $value = sprintf "$dir/$words[0].$words[1].$words[2].$words[3].mode.list";
	    last;
	}
	# list of image map lists
	if ($type eq "modefits") {
	    $dir = mkfiles ("fringe");
