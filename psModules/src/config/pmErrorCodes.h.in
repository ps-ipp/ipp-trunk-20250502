#if !defined(PM_ERROR_CODES_H)
#define PM_ERROR_CODES_H
/*
 * The line
 *  PM_ERR_$X{ErrorCode},
 * (without the X)
 *
 * will be replaced by values from errorCodes.dat
 */
typedef enum {
    PM_ERR_BASE = 1000,
    PM_ERR_${ErrorCode},
    PM_ERR_NERROR
} pmErrorCode;

void pmErrorRegister(void);

#endif
