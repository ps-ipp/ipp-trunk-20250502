
detRunDef MULTI

detRunDef METADATA
  detRunName STR BIAS
  prereq     STR NONE
  options    STR "-definebyquery -workdir path://EAMWORK -inst SIMTEST -det_type BIAS -select_exp_type BIAS"
  dbname     STR eamtest
  pantaskState STR NULL
END

