# Camera configuration file for Cfh12k: describes the camera

# File formats that we know about
FORMATS		METADATA
	RAW	STR	tc3/format.config
	PS2	STR	tc3/format_ps2.config
	TC1	STR	tc3/format_tc1.config
END

