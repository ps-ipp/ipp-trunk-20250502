COMP_IMG	METADATA
	BITPIX		S32	16
	SCALING		STR	STDEV_POSITIVE
	STDEV.BITS	S32	4
	STDEV.NUM	F32	10
	COMPRESSION	STR	RICE
	TILE.X		S32	0
	TILE.Y		S32	1
	TILE.Z		S32	1
	NOISE		S32	8
END

