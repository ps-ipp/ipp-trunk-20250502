        CDF90   F32 22.471900
        CDF95   F32 22.540200
        CDF99   F32 22.657600
        CDF100  F32 22.992000
    END
    RULE METADATA
        COLNAME STR DETEFF
        RULETYPE STR CDF
        FILTER  STR r.00000
