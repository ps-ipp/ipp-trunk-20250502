    RULE METADATA
        COLNAME STR FWHM_MAJOR
	RULETYPE STR UNUSED
	MINIMUM F32 0.0
	MAXIMUM F32 9.3            # 90-percentile 2010-02-14 through 2010-06-20 = 2.4"
    END
    RULE METADATA
    	COLNAME STR FWHM_MINOR
	RULETYPE STR UNUSED
	MINIMUM F32 0.0
	MAXIMUM F32 8.44	   # 90-percentile 2010-02-14 through 2010-06-20 = 2.18"
    END
    RULE METADATA
    	 COLNAME STR ZEROPOINT
	RULETYPE STR UNUSED
	 FILTER  STR g.00000
	 MINIMUM F32 24.3051           # (median 2010-02-14 through 2010-06-20) - 0.25 magnitudes
	 MAXIMUM F32 99.9999           # We refuse to believe in negative clouds.
    END
    RULE METADATA
    	 COLNAME STR ZEROPOINT
	RULETYPE STR UNUSED
	 FILTER  STR r.00000
	 MINIMUM F32 24.5294           # (median 2010-02-14 through 2010-06-20) - 0.25 magnitudes
	 MAXIMUM F32 99.9999           # We refuse to believe in negative clouds.
    END
    RULE METADATA
    	 COLNAME STR ZEROPOINT
	RULETYPE STR UNUSED
	 FILTER  STR i.00000
	 MINIMUM F32 24.4641           # (median 2010-02-14 through 2010-06-20) - 0.25 magnitudes
	 MAXIMUM F32 99.9999           # We refuse to believe in negative clouds.
    END
    RULE METADATA
    	 COLNAME STR ZEROPOINT
	RULETYPE STR UNUSED
	 FILTER  STR z.00000
	 MINIMUM F32 24.1128           # (median 2010-02-14 through 2010-06-20) - 0.25 magnitudes
	 MAXIMUM F32 99.9999           # We refuse to believe in negative clouds.
    END
    RULE METADATA
    	 COLNAME STR ZEROPOINT
	RULETYPE STR UNUSED
	 FILTER  STR y.00000
	 MINIMUM F32 23.1503           # (median 2010-02-14 through 2010-06-20) - 0.25 magnitudes
	 MAXIMUM F32 99.9999           # We refuse to believe in negative clouds.
    END
    RULE METADATA
    	 COLNAME STR ZEROPOINT
	RULETYPE STR UNUSED
	 FILTER  STR w.00000
	 MINIMUM F32 25.8944           # (median 2010-02-14 through 2010-06-20) - 0.25 magnitudes
	 MAXIMUM F32 99.9999           # We refuse to believe in negative clouds.
    END
END

STATS.COLUMNS METADATA             # Column definitions for what goes into a bundle
    COLUMN MULTI
    TYPE   VAL TABLE            ENTRY             DATATYPE       COLNAME
    COLUMN VAL rawExp           exp_name          PS_DATA_STRING EXPNAME             # Exposure name
    COLUMN VAL rawExp		camera		  PS_DATA_STRING CAMERA		     # The camera for this exposure
    COLUMN VAL rawExp           dateobs           PS_DATA_TIME   DATEOBS             # Date of observation
    COLUMN VAL rawExp           filter            PS_DATA_STRING FILTER              # Filter used
    COLUMN VAL rawExp           comment           PS_DATA_STRING COMMENT             # Obs comment
    COLUMN VAL rawExp           ra  	          PS_DATA_F64 	 RA                  # Right ascension
    COLUMN VAL rawExp           decl 	          PS_DATA_F64    DEC                 # Declination
    COLUMN VAL rawExp           exp_time          PS_DATA_F32    EXPTIME	     # Exposure time
    COLUMN VAL rawExp           obs_mode          PS_DATA_STRING OBS_MODE

    COLUMN VAL camProcessedExp  zpt_obs           PS_DATA_F32    ZEROPOINT	     
    COLUMN VAL camProcessedExp  zpt_stdev         PS_DATA_F32    ZEROPOINT_STDEV     
    COLUMN VAL camProcessedExp  zpt_lq            PS_DATA_F32    ZEROPOINT_LQ	     
    COLUMN VAL camProcessedExp  zpt_uq            PS_DATA_F32    ZEROPOINT_UQ	     

    COLUMN VAL camProcessedExp  fwhm_major        PS_DATA_F32    FWHM_MAJOR	     
    COLUMN VAL camProcessedExp  fwhm_major_lq     PS_DATA_F32    FWHM_MAJOR_LQ	     
    COLUMN VAL camProcessedExp  fwhm_major_uq     PS_DATA_F32    FWHM_MAJOR_UQ	     
    COLUMN VAL camProcessedExp  fwhm_minor        PS_DATA_F32    FWHM_MINOR	     
    COLUMN VAL camProcessedExp  fwhm_minor_lq     PS_DATA_F32    FWHM_MINOR_LQ	     
    COLUMN VAL camProcessedExp  fwhm_minor_uq     PS_DATA_F32    FWHM_MINOR_UQ	     

    COLUMN VAL camProcessedExp  iq_fwhm_major     PS_DATA_F32    IQ_FWHM_MAJOR	     
    COLUMN VAL camProcessedExp  iq_fwhm_major_err PS_DATA_F32    IQ_FWHM_MAJOR_ERR   
    COLUMN VAL camProcessedExp  iq_fwhm_minor     PS_DATA_F32    IQ_FWHM_MINOR	     
    COLUMN VAL camProcessedExp  iq_fwhm_minor_err PS_DATA_F32    IQ_FWHM_MINOR_ERR   

    COLUMN VAL camProcessedExp  iq_m2             PS_DATA_F32    IQ_M2		     
    COLUMN VAL camProcessedExp  iq_m2_err         PS_DATA_F32    IQ_M2_ERR	     
    COLUMN VAL camProcessedExp  iq_m2_lq          PS_DATA_F32    IQ_M2_LQ	     
    COLUMN VAL camProcessedExp  iq_m2_uq          PS_DATA_F32    IQ_M2_UQ	     

    COLUMN VAL camProcessedExp  iq_m2c            PS_DATA_F32    IQ_M2C		     
    COLUMN VAL camProcessedExp  iq_m2c_err        PS_DATA_F32    IQ_M2C_ERR	     
    COLUMN VAL camProcessedExp  iq_m2c_lq         PS_DATA_F32    IQ_M2C_LQ	     
    COLUMN VAL camProcessedExp  iq_m2c_uq         PS_DATA_F32    IQ_M2C_UQ	     

    COLUMN VAL camProcessedExp  iq_m2s            PS_DATA_F32    IQ_M2S		     
    COLUMN VAL camProcessedExp  iq_m2s_err        PS_DATA_F32    IQ_M2S_ERR	     
    COLUMN VAL camProcessedExp  iq_m2s_lq         PS_DATA_F32    IQ_M2S_LQ	     
    COLUMN VAL camProcessedExp  iq_m2s_uq         PS_DATA_F32    IQ_M2S_UQ	     

    COLUMN VAL camProcessedExp  iq_m3             PS_DATA_F32    IQ_M3		     
    COLUMN VAL camProcessedExp  iq_m3_err         PS_DATA_F32    IQ_M3_ERR	     
    COLUMN VAL camProcessedExp  iq_m3_lq          PS_DATA_F32    IQ_M3_LQ	     
    COLUMN VAL camProcessedExp  iq_m3_uq          PS_DATA_F32    IQ_M3_UQ	     

    COLUMN VAL camProcessedExp  iq_m4             PS_DATA_F32    IQ_M4		     
    COLUMN VAL camProcessedExp  iq_m4_err         PS_DATA_F32    IQ_M4_ERR	     
    COLUMN VAL camProcessedExp  iq_m4_lq          PS_DATA_F32    IQ_M4_LQ	     
    COLUMN VAL camProcessedExp  iq_m4_uq          PS_DATA_F32    IQ_M4_UQ	     
    COLUMN VAL camProcessedExp  deteff            PS_DATA_F32    DETEFF
    COLUMN VAL camProcessedExp  quality           PS_DATA_S32    CAMRUN_QUALITY
END

