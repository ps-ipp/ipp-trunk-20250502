    RULE METADATA
        COLNAME STR DETEFF
        RULETYPE STR CDF
        FILTER  STR i.00000
        CDF00   F32 15.811400
        CDF05   F32 20.490100
        CDF10   F32 21.001400
        CDF15   F32 21.176500
