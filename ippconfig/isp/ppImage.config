  DARK               BOOL    TRUE            # Dark subtraction
  SHUTTER            BOOL    FALSE           # Shutter correction
  FLAT               BOOL    FALSE           # Flat-field normalisation
  MASK               BOOL    FALSE           # Mask bad pixels
  FRINGE             BOOL    FALSE           # Fringe subtraction
