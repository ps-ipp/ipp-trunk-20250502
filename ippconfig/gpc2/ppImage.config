BACKGROUND		BOOL    FALSE	
# binned output image options
BIN1.XBIN               S32      16
BIN1.YBIN               S32      16
BIN2.XBIN               S32     150
BIN2.YBIN               S32     150

OVERSCAN.SINGLE         BOOL    FALSE            # Reduce overscan to a single value?
OVERSCAN.STAT           STR     MEDIAN
OVERSCAN.BOXCAR         S32     3

# Normalization class
NORM.CLASS              STR     CHIP             # How to find the per-class normalizations

NONLIN                  BOOL    FALSE            # apply non-linearity correction 
OLDDARK                 BOOL    FALSE

PATTERN.DEAD.CELLS      BOOL    FALSE            # mask dead cells based on background patterns

GAIN.OVERRIDE		BOOL	TRUE		# Override a non-finite gain?

# use the deburned image instead of the raw, if it exists
USE.DEBURNED.IMAGE      BOOL    FALSE          # use burntool-repaired image?
USE.BEST.BURNTOOL	BOOL	FALSE       # require the best burntooled data
MASK.BURNTOOL           BOOL    FALSE          # Mask potential burntool trails
TILTYSTREAK.APPLY       BOOL    FALSE          # apply the 'tiltystreak' tool
NOISEMAP                BOOL    FALSE          # Apply read noise map

APPLY.BURNTOOL          BOOL    FALSE          # apply burntool correction in ppImage

# Final detrending options 
HAS.VIDEO       BOOL    FALSE            # Treat this OTA as if it has video data
# USE.VIDEO.DARK  BOOL    TRUE             # Use a video dark if we have video data?
USE.VIDEO.MASK  BOOL    FALSE            # Use a video mask if we have video data?

# aditional auxiliary mask applied to corners of all chips in video cells.
# Is only applied if MASK.AUXMASK and USE.VIDEO.MASK are both true
# AUX.VIDEO.MASK  STR     neb://any/gpc1/auxmask/mpg.20130930/mask_video_cell_corners.fits

# only valid for GPC1
TILTYSTREAK.BY.CLASS METADATA              # apply the 'tiltystreak' tool
END

# crosstalk measurements : only valid for GPC1 for now
CROSSTALK.MEASURE  BOOL    FALSE          # Subtract model background?
CROSSTALK.CORRECT  BOOL    FALSE           # Subtract model background?

