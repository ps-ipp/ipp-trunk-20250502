DETREND.CONSTRAINTS  METADATA
  BIAS METADATA
  END
  DARK METADATA
    EXPTIME STR FPA.EXPOSURE
  END
  FLAT METADATA
    FILTER  STR FPA.FILTERID
  END
  FLATCORR METADATA
    FILTER   STR FPA.FILTERID
  END
  FRINGE METADATA
    FILTER   STR FPA.FILTERID
  END
  SHUTTER METADATA
  END
  MASK METADATA
  END	
  ASTROM METADATA
  END	
  NOISEMAP METADATA
  END	
  LINEARITY METADATA
  END
END

