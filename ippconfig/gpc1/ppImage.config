# burntool turned off for manual reprocessing of problematic exposures
# https://jira.ipp.ifa.hawaii.edu/browse/IPP-1451
# modified from gpc1 default CHIP recipe
CHIP_NOBURNTOOL METADATA
  BASE.FITS          BOOL    FALSE           # Save base detrended image?
