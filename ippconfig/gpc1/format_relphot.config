# How to translation PS concepts into database lookups
DATABASE	METADATA
END


# Where there might be some ambiguity, specify the format
FORMATS		METADATA
	FPA.RA		STR	DEGREES
	FPA.DEC		STR	DEGREES
	FPA.TIME	STR	MJD
	CELL.TIME	STR	MJD
	CELL.BINNING	STR	TOGETHER
	# CELL.X0		STR	FORTRAN
	# CELL.Y0		STR	FORTRAN
END
 
