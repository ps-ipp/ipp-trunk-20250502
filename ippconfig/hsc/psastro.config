#REFSTAR_MASK_GLINTS		BOOL TRUE
REFSTAR_MASK_GLINTS		BOOL FALSE
GLINT_MAX_MAG			F32  -19
GLINT_LENGTH_MAG_SLOPE		F32  0.0
GLINT_LENGTH_MAG_ZERO		F32  0.0
GLINT_WIDTH			F32  80.0

# HSC glint model terms:
# FILTER : allows model to have different terms for different filters
# FACTOR : scaling factor for glint model in mm for each filter
# LIMIT  : instrumental magnitude limit (only brighter stars are used)
#          example, for g-band 30 sec exposures, limit of -23 -> 7.5 mag
#
# to find the glint:
#  R_FPA = hypot(TP_x, TP_y) --> note calculation is done in TPA units, not FPA units
#  theta0 = datan2 (TP_y, TP_x)
#  R (star_radius_deg) = GLINT.PIXEL.SCALE * R_FPA
#  C_star = C_terms[0] + C_terms[1] * R + C_terms[2] * R^2
#  R_star = R_terms[0] + R_terms[1] * R + R_terms[2] * R^2

# C_star and R_star are in millimeter units; R is in degrees.

# The slopes and radii and region below are all in FPA units, 1/13.5 of a regular pixel.
# these need to be adjusted to use 1 FPA pix = 1 CHIP pix (hsc.20200221.asm)

# recipe values which need to be adjusted for 1 FPA pix = 1 CHIP pix:
# GLINT.PIXEL.SCALE (multiply by 13.4)
# REGION (divide by 13.4)
# GLINT.RADIUS.INNER (divide by 13.4)
# GLINT.RADIUS.OUTER (divide by 13.4)

# NOTE: The code contains the 13.5 factor hard-wired in the HSC model

GLINT.REGION			MULTI
GLINT.REGION			METADATA
  GLINT.TYPE                    STR  HSC
  GLINT.PIXEL.SCALE		F32  3.49794238e-06
  REGION			STR  [-350000:350000,-350000:350000]
  GLINT.RADIUS.INNER            F32  252435  # 0.883 degrees
  GLINT.RADIUS.OUTER		F32  283025  # 0.990 degrees
  
  GLINT.FILTER.TERM		MULTI
  GLINT.FILTER.TERM		METADATA
    FILTER			STR	g
    @C_TERMS			F32	-4467.9759580157  10022.1277915657  -5156.3556611527 # a comment
    @R_TERMS			F32	-4375.9715493905  9717.6993803237   -5203.2424778605 # a comment
    FACTOR			F32	1.002
    LIMIT			F32	-23.0
  END
  GLINT.FILTER.TERM		METADATA
    FILTER			STR      r
    @C_TERMS			F32	 -4354.2575893763  9762.9766653532  -5011.1243975288 # a comment
    @R_TERMS			F32	 -4263.2230039887  9457.4516871365  -5057.2762518308 # a comment
    FACTOR			F32	 1.0015
    LIMIT			F32	 -23.5
  END
  GLINT.FILTER.TERM		METADATA
    FILTER			STR      i
    @C_TERMS			F32	 -4243.1837126908  9517.3512135240  -4876.3237965836 # a comment
    @R_TERMS			F32	 -4154.5095389959  9215.4140278639  -4924.2923196315 # a comment
    FACTOR			F32	1.001
    LIMIT			F32	-23.5
  END
  GLINT.FILTER.TERM		METADATA
    FILTER			STR      z
    @C_TERMS			F32	 -3966.2315539829  8920.7199277389  -4555.9567436784 # a comment
    @R_TERMS			F32	 -3878.4529585585  8619.7241050446  -4604.3603386145 # a comment
    FACTOR			F32	0.9995
    LIMIT			F32	13.0
  END
  GLINT.FILTER.TERM		METADATA
    FILTER			STR      y
    @C_TERMS			F32	 -3723.5919271089  8403.7641770854  -4281.0159171765 # a comment
    @R_TERMS			F32	 -3637.0352789862  8104.8245491120  -4330.4583627761 # a comment
    FACTOR			F32	1.000
    LIMIT			F32	-23.0
  END
  GLINT.FILTER.TERM		METADATA
    FILTER			STR      NB816
    @C_TERMS			F32	 -4243.1837126908  9517.3512135240  -4876.3237965836 # a comment
    @R_TERMS			F32	 -4154.5095389959  9215.4140278639  -4924.2923196315 # a comment
    FACTOR			F32	1.001
    LIMIT			F32	-24.0
  END
  GLINT.FILTER.TERM		METADATA
    FILTER			STR      NB921
    @C_TERMS			F32	 -3966.2315539829  8920.7199277389  -4555.9567436784 # a comment
    @R_TERMS			F32	 -3878.4529585585  8619.7241050446  -4604.3603386145 # a comment
    FACTOR			F32	1.0005
    LIMIT			F32	-24.0
  END

END

