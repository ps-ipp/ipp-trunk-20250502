
# with the external model, this has no effect (it is ignored)
# XXX not quite true: this is used by the ghost & glint model
PSASTRO.PIXEL.SCALE    F32     1.0

# these values are in FP coordinates
# these are appropriate for hsc.20200221.asm (1 FP pixel = 1 chip pixel)
PSASTRO.GRID.OFFSET         F32 100.
PSASTRO.GRID.SCALE          F32 5.
PSASTRO.TWEAK.RANGE         F32 5.
PSASTRO.REFSTAR.CLUMP.SCALE S32 10

# these are appropriate for hsc.20161020.asm (13.4 FP pixel = 1 chip pixels)
# PSASTRO.GRID.OFFSET         F32 1000.
# PSASTRO.GRID.SCALE          F32 50.
# PSASTRO.TWEAK.RANGE         F32 10
# PSASTRO.REFSTAR.CLUMP.SCALE S32 150

PSASTRO.SAVE.REFMATCH         BOOL     T  # save refstars in a separate FITS table
PSASTRO.SAVE.REFSTARS         BOOL     F  # save refstars in a separate FITS file (broken!)

