PSASTRO.GRID.MAX.ANGLE F32 +2.0
PSASTRO.GRID.DEL.ANGLE F32  1.0

PSASTRO.GRID.NREF.MAX  S32   5000 # max stars accepted for fitting
PSASTRO.GRID.NRAW.MAX  S32   5000 # max stars accepted for fitting

PSASTRO.MIN.INST.MAG.RAW            F32      -15   # min instrumental magnitude for stars accepted for fitting
PSASTRO.MAX.INST.MAG.RAW            F32      -11   # max instrumental magnitude for stars accepted for fitting
PSASTRO.GRID.MIN.INST.MAG.RAW       F32      -15
PSASTRO.GRID.MAX.INST.MAG.RAW       F32      -11

## PSASTRO.GRID.MAX.INST.MAG.RAW -11 is OK for the 30 sec exp but may be too many for 300 sec.

# pmAstromMatchFit
PSASTRO.CHIP.ORDER     S32      1  # fit order
PSASTRO.CHIP.NITER     S32      3  # fit clipping iterations
PSASTRO.CHIP.NSIGMA    F32      3  # fit clipping sigmas

# single-chip radius match in FP pixels
# These are appropriate for hsc.20161020.asm (13.4 FP pixel = 1 chip pixels)
# PSASTRO.MATCH.RADIUS.N0 F32    30
# PSASTRO.MATCH.RADIUS.N1 F32    30
# PSASTRO.MATCH.RADIUS.N2 F32    20
# PSASTRO.MATCH.RADIUS.N3 F32    20
# PSASTRO.MATCH.RADIUS.N4 F32    10
# PSASTRO.MATCH.RADIUS.N5 F32    10 # was 5
# PSASTRO.MATCH.RADIUS.N6 F32     8
# PSASTRO.MATCH.RADIUS.N7 F32     8
# PSASTRO.MATCH.FIT.NITER S32     7 # was 7

# these are appropriate for hsc.20200221.asm (1 FP pixel = 1 chip pixel)
# EAM NOTE: test this recipe for field images (non-M31)
PSASTRO.MATCH.RADIUS.N0 F32    6.0
PSASTRO.MATCH.RADIUS.N1 F32    6.0
PSASTRO.MATCH.RADIUS.N2 F32    4.0
PSASTRO.MATCH.RADIUS.N3 F32    4.0
PSASTRO.MATCH.RADIUS.N4 F32    2.0
PSASTRO.MATCH.RADIUS.N5 F32    2.0
PSASTRO.MATCH.RADIUS.N6 F32    1.5
PSASTRO.MATCH.RADIUS.N7 F32    1.5
PSASTRO.MATCH.FIT.NITER S32     7 # was 7

# single-chip radius match in pixels
PSASTRO.ONE.CHIP.ORDER.N0 F32    1
PSASTRO.ONE.CHIP.ORDER.N1 F32    1 
PSASTRO.ONE.CHIP.ORDER.N2 F32    2
PSASTRO.ONE.CHIP.ORDER.N3 F32    2
PSASTRO.ONE.CHIP.ORDER.N4 F32    3
PSASTRO.ONE.CHIP.ORDER.N5 F32    3
PSASTRO.ONE.CHIP.ORDER.N6 F32    3
PSASTRO.ONE.CHIP.ORDER.N7 F32    3

# Mosaic Astrometry options
PSASTRO.MOSAIC.MODE         BOOL   TRUE

# for iterations >= N, require a single match per reference
PSASTRO.MOSAIC.CHIP.NITER     S32      5  # fit clipping iterations (NOTE: last iteration is NITER, not NITER - 1)
PSASTRO.MOSAIC.CHIP.NSIGMA    F32      3  # fit clipping sigmas
PSASTRO.MOSAIC.UNIQ.ITER      S32      3  # for iterations >= N, require a single match per reference

PSASTRO.MOSAIC.MAX.ERROR.N0 F32    0.00 # max allow error for valid solution (arcsec)
PSASTRO.MOSAIC.MAX.ERROR.N1 F32    0.00 # max allow error for valid solution (arcsec)
PSASTRO.MOSAIC.MAX.ERROR.N2 F32    0.00 # max allow error for valid solution (arcsec)
PSASTRO.MOSAIC.MAX.ERROR.N3 F32    0.00 # max allow error for valid solution (arcsec)
PSASTRO.MOSAIC.MAX.ERROR.N4 F32    0.00 # max allow error for valid solution (arcsec)
PSASTRO.MOSAIC.MAX.ERROR.N5 F32    0.30 # max allow error for valid solution (arcsec)

# mosaic radius match in Chip pixels (do these make sense?)
# the smallest one-chip radius (8) should roughly match the 
# largest mosaic radius x plate scale
PSASTRO.MOSAIC.RADIUS.N0    F32    3
PSASTRO.MOSAIC.RADIUS.N1    F32    3
PSASTRO.MOSAIC.RADIUS.N2    F32    2
PSASTRO.MOSAIC.RADIUS.N3    F32    2
PSASTRO.MOSAIC.RADIUS.N4    F32    2
PSASTRO.MOSAIC.RADIUS.N5    F32    2

# use 3rd order all the way.
PSASTRO.MOSAIC.CHIP.ORDER     S32      3  # limit chip-fit order to 1
PSASTRO.MOSAIC.CHIP.ORDER.N0  S32      3 # fit order (-1 means use default)
PSASTRO.MOSAIC.CHIP.ORDER.N1  S32      3 # fit order (-1 means use default)
PSASTRO.MOSAIC.CHIP.ORDER.N2  S32      3 # fit order (-1 means use default)
PSASTRO.MOSAIC.CHIP.ORDER.N3  S32      3 # fit order (-1 means use default)
PSASTRO.MOSAIC.CHIP.ORDER.N4  S32      3 # fit order (-1 means use default)
PSASTRO.MOSAIC.CHIP.ORDER.N5  S32      3 # fit order (-1 means use default)

# mosaic radius match in Chip pixels (do these make sense?)
